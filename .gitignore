# Publish reviewed application source only. Creator projects and machine setup
# already live alongside this folder and must never be staged by git add .
/*
!/.gitignore
!/.gitattributes
!/README.md
!/settings.example.json
!/Start Storyboard Desk.command
!/Start Storyboard Desk.bat
!/Start Storyboard Desk Go.command
!/Start Storyboard Desk Go.bat
!/gosx-host/
/gosx-host/*
!/gosx-host/go.mod
!/gosx-host/go.sum
!/gosx-host/*.go
!/gosx-host/*.gsx
!/gosx-host/workspace.css
!/gosx-host/gosx.config.json
!/gosx-host/client/
/gosx-host/client/*
!/gosx-host/client/*.go
!/gosx-host/clientassets/
/gosx-host/clientassets/*
!/gosx-host/clientassets/README.md
!/gosx-host/internal/
/gosx-host/internal/*
!/gosx-host/internal/clientbuild/
/gosx-host/internal/clientbuild/*
!/gosx-host/internal/clientbuild/*.go
!/gosx-host/cloud_catalog.json
!/gosx-host/cmd/
/gosx-host/cmd/*
!/gosx-host/cmd/package/
/gosx-host/cmd/package/*
!/gosx-host/cmd/package/*.go
!/gosx-host/cmd/native/
/gosx-host/cmd/native/*
!/gosx-host/cmd/native/*.go
!/gosx-host/cmd/client/
/gosx-host/cmd/client/*
!/gosx-host/cmd/client/*.go
!/gosx-host/testdata/
/gosx-host/testdata/*
!/gosx-host/testdata/legacy/
!/gosx-host/testdata/legacy/**
!/cowboy.json
!/templates/
/templates/*
!/templates/storyboard-project-template.json
!/media_probe.swift
!/export_range.swift
!/export_reel.swift
!/tests/
/tests/*
!/tests/make_video_fixture.swift
!/docs/
/docs/*
!/docs/GETTING_STARTED.md
!/docs/PORTABILITY.md
!/docs/GOSX_PORT.md
!/docs/GOSX_MIGRATION_SPEC.md
!/docs/gosx-storage-verification.json
!/docs/gosx-port-verification.json
!/docs/gosx-workspace-desktop.png
!/docs/gosx-workspace-mobile.png
!/docs/gosx-workspace-media.png
!/docs/gosx-windows-initial.png
!/docs/gosx-windows-native.png
!/docs/gosx-windows-verification.json
!/docs/gosx-retirement-verification.json
!/docs/gosx-mac-verification.json
!/docs/gosx-mac-native.png
!/docs/gosx-mac-native-go.png
!/docs/gosx-mac-save-dialog.png
!/docs/gosx-mac-custom-name.png
!/docs/gosx-mac-custom-folder.png
!/docs/gosx-go-client-verification.json
!/docs/gosx-go-client-desktop.png
!/docs/gosx-go-client-mobile.png
!/docs/gosx-shot-validation.png
!/.github/
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/ci.yml
__pycache__/
*.py[cod]
.DS_Store
.env
.env.*
settings.local.json
*.key
*.pem
